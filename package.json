{
  "name": "menuify",
  "type": "module",
  "version": "0.0.18",
  "packageManager": "pnpm@10.7.1",
  "description": "A CLI menu generator with advanced features like task dependencies, user inputs, and environment variables support.",
  "author": "baiawxk <baiawxk@qq.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/baiawxk",
  "homepage": "https://github.com/baiawxk/menuify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiawxk/menuify.git"
  },
  "bugs": "https://github.com/baiawxk/menuify/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "menuify": "./dist/bin/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint",
    "prepublishOnly": "nr build",
    "release": "bumpp -p false && pnpm publish",
    "link": "npm link",
    "start": "tsx src/bin/cli.ts",
    "test": "vitest -w false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "boxen": "^8.0.1",
    "cac": "^6.7.14",
    "chalk": "^5.4.1",
    "chq-eslint": "^0.0.8",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "execa": "^9.5.2",
    "listr2": "^8.3.2",
    "open": "^10.1.0",
    "radash": "^12.1.0",
    "unconfig": "^7.3.1"
  },
  "devDependencies": {
    "@antfu/ni": "^24.3.0",
    "@antfu/utils": "^9.2.0",
    "@types/node": "^22.14.0",
    "bumpp": "^10.1.0",
    "eslint": "^9.24.0",
    "lint-staged": "^15.5.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.12.1",
    "tinyexec": "^1.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vitest-package-exports": "^0.1.1",
    "yaml": "^2.7.1"
  }
}
