{
  "name": "menuify",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@10.7.1",
  "description": "_description_",
  "author": "baiawxk <baiawxk@qq.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/baiawxk",
  "homepage": "https://github.com/baiawxk/menuify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiawxk/menuify.git"
  },
  "bugs": "https://github.com/baiawxk/menuify/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "menuify": "./dist/bin/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "shelljs": "^0.9.2",
    "unconfig": "^7.3.1"
  },

  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@antfu/ni": "^24.3.0",
    "@antfu/utils": "^9.2.0",
    "@types/node": "^22.14.0",
    "@types/shelljs": "^0.8.15",
    "bumpp": "^10.1.0",
    "eslint": "^9.24.0",
    "lint-staged": "^15.5.0",
    "simple-git-hooks": "^2.12.1",
    "tinyexec": "^1.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vitest-package-exports": "^0.1.1",
    "yaml": "^2.7.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
