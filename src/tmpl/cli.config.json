{
  "menus": [
    {
      "name": "Start Development",
      "type": "command",
      "value": "npm run dev",
      "group": "develop"
    },
    {
      "name": "Build Project",
      "type": "command",
      "value": "npm run build",
      "group": "build"
    },
    {
      "name": "Test",
      "type": "command",
      "value": "npm test",
      "group": "test"
    },
    {
      "name": "Git Operations",
      "type": "command",
      "value": "${command}",
      "group": "git",
      "inputs": [
        {
          "id": "command",
          "type": "pickString",
          "description": "Select git operation",
          "options": [
            "git status",
            "git add .",
            "git commit -m \"${message}\"",
            "git push",
            "git pull"
          ]
        },
        {
          "id": "message",
          "type": "promptString",
          "description": "Enter commit message",
          "default": "update"
        }
      ]
    },
    {
      "name": "Open Documentation",
      "type": "link",
      "value": "https://docs.example.com",
      "group": "help"
    }
  ]
}
